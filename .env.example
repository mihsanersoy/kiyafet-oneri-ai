# Google AI Studio'dan alınan Gemini API Anahtarı
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Anahtarı (İsteğe bağlı - boş bırakılırsa ücretsiz Open-Meteo kullanılır)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL Veritabanı Bağlantısı (Boş bırakılırsa yerel SQLite scenarios.db kullanılır)
# Örnek: DATABASE_URL=postgresql://postgres:sifre@localhost:5432/kiyafet_ai
DATABASE_URL=

# Frontend için Backend API Adresi (Varsayılan: http://127.0.0.1:8001)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
