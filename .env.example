# Google AI Studio'dan alınan Gemini API Anahtarı
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Anahtarı (İsteğe bağlı - boş bırakılırsa ücretsiz Open-Meteo kullanılır)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL Veritabanı Bağlantısı (Boş bırakılırsa yerel SQLite scenarios.db kullanılır)
# Örnek: DATABASE_URL=postgresql://postgres:sifre@localhost:5432/optiwear_db
DATABASE_URL=

# ==========================================
# Siber Güvenlik & Kimlik Doğrulama (JWT + PII Şifreleme)
# ==========================================
# JWT Access & Refresh Token imzalama anahtarı (En az 32 karakter rastgele güçlü anahtar)
JWT_SECRET_KEY=replace_with_a_strong_256_bit_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Veritabanındaki hassas verileri (telefon numarası vb.) şifrelemek için Fernet / AES anahtarı
PII_ENCRYPTION_KEY=replace_with_32_byte_base64_fernet_key_here

# ==========================================
# Gerçek E-Posta (SMTP) OTP Gönderimi (İsteğe Bağlı)
# Boş bırakılırsa 6 haneli OTP kodu Backend terminal ekranına yazdırılır.
# Gerçek mail atması için Gmail adresinizi ve 16 haneli "Uygulama Şifrenizi" (App Password) girin:
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Strict CORS: İzin verilen güvenli kaynaklar (Virgülle ayrılmış)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend için Backend API Adresi (Varsayılan: http://127.0.0.1:8001)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
